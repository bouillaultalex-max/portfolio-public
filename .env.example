# Coordonnées publiques — facultatives. Copier ce fichier en .env.local (non versionné).
# Les variables VITE_* sont PUBLIQUES après compilation : n'y mettre que des valeurs
# validées pour diffusion. Jamais de secret ni de clé API.
#
# Une variable vide masque l'élément correspondant sur le site.
# Une valeur renseignée mais invalide fait échouer le build (voir src/lib/contact.ts).

# Adresse e-mail affichée dans « Contact » (lien mailto).
VITE_CONTACT_EMAIL=

# Profil LinkedIn, format exact : https://www.linkedin.com/in/identifiant
VITE_LINKEDIN_URL=

# CV PDF servi par le site : placer le fichier dans public/cv/ puis indiquer son chemin.
# Format : /cv/nom-en-minuscules.pdf — si une seule langue existe, elle est proposée dans les deux.
VITE_CV_URL_FR=/cv/cv-alexandre-bouillault-product-builder-ia-fr.pdf
VITE_CV_URL_EN=
